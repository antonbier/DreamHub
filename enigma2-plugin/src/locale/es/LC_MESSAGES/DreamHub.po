"Language: es\n"

msgid "Open DreamHub on your phone"
msgstr "Abrir DreamHub en el móvil"

msgid "DreamHub"
msgstr "DreamHub"

msgid "Checking backend…"
msgstr "Comprobando el backend…"

msgid "Scan this code with your phone's camera to open DreamHub."
msgstr "Escanea este código con la cámara del móvil para abrir DreamHub."

msgid "Close"
msgstr "Cerrar"

msgid "Settings"
msgstr "Ajustes"

msgid "Backend running (v%s)\nThis plugin is v%s — versions differ, some things may not match."
msgstr "Backend en marcha (v%s)\nEste plugin es la v%s — las versiones no coinciden, algunas cosas pueden no encajar."

msgid "Backend running (v%s)"
msgstr "Backend en marcha (v%s)"

msgid "Backend not reachable on this box.\nIs DreamHub installed and running?"
msgstr "El backend no responde en este receptor.\n¿Está DreamHub instalado y en marcha?"

msgid "DreamHub Settings"
msgstr "Ajustes de DreamHub"

msgid "Backend port"
msgstr "Puerto del backend"

msgid "Backend requires a password"
msgstr "El backend pide una contraseña"

msgid "Cancel"
msgstr "Cancelar"

msgid "Save"
msgstr "Guardar"

msgid "Change the DreamHub port to %d?\n\nDreamHub restarts for a few seconds. Browsers and bookmarks need the new address (http://<box>:%d)."
msgstr "¿Cambiar el puerto de DreamHub a %d?\n\nDreamHub se reinicia durante unos segundos. Los navegadores y marcadores necesitan la nueva dirección (http://<box>:%d)."

msgid "The port could not be saved: %s"
msgstr "No se pudo guardar el puerto: %s"
