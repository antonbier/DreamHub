#!/bin/sh
# postinst runs after files are unpacked (dpkg convention: "configure").
# PRINCIPLES.md: nothing happens silently — every step here is either
# something the user already asked for by installing this package, or
# something safe to redo (systemctl daemon-reload, enable).
set -e

# /data is the box's own persistent partition (PRINCIPLES.md, "Data
# storage: one SQLite file, on /data") — the binary itself also creates
# this with umask 077 at startup, but doing it here too means the very
# first `systemctl start` below doesn't race an empty directory.
mkdir -p /data/dreamhub
chmod 700 /data/dreamhub

if [ -d /run/systemd/system ]; then
    systemctl daemon-reload || true
    systemctl enable dreamhub.service || true
    systemctl restart dreamhub.service || true
    sleep 2
    if ! systemctl is-active --quiet dreamhub.service; then
        echo "dreamhub: the service did not start. Most likely its port is taken by another program."
        echo "dreamhub: see 'journalctl -u dreamhub -n 20'; set a free port with"
        echo "dreamhub:   echo 'DREAMHUB_LISTEN_ADDR=:<port>' > /etc/default/dreamhub && systemctl restart dreamhub"
    fi
    # Docker set up from the Apps tab: pick up a new helper binary. Never
    # restarts dockerd itself (the apps keep running).
    if systemctl is-enabled --quiet dreamhub-dockerd-helper.service 2>/dev/null; then
        systemctl restart dreamhub-dockerd-helper.service || true
    fi
    # Extensions are BoundTo dreamhub.service: restarting it above stopped
    # them (found on the box on 2026-10-16, eWeLink stayed dead after an
    # update). Start the enabled ones again; they register with DreamHub.
    for unit in $(systemctl list-unit-files 'dreamhub-ext-*.service' --no-legend 2>/dev/null | awk '{print $1}'); do
        if systemctl is-enabled --quiet "$unit" 2>/dev/null; then
            systemctl start "$unit" || true
        fi
    done
fi

# The mDNS advertisement follows the port in /etc/default/dreamhub (if set).
PORT=$(sed -n 's/^DREAMHUB_LISTEN_ADDR=.*:\([0-9][0-9]*\)$/\1/p' /etc/default/dreamhub 2>/dev/null | tail -n 1)
if [ -n "$PORT" ] && [ -f /etc/avahi/services/dreamhub.service ]; then
    sed -i "s|<port>[0-9]*</port>|<port>$PORT</port>|" /etc/avahi/services/dreamhub.service
fi

if command -v systemctl >/dev/null 2>&1 && systemctl is-active --quiet avahi-daemon 2>/dev/null; then
    systemctl reload avahi-daemon || true
fi

# The Enigma2 plugin only takes effect after enigma2 re-scans its plugin
# list, which happens on GUI startup. enigma2 is never restarted from here
# (PRINCIPLES.md, "Preview and confirm"): someone may be watching TV or a
# recording may be about to start, and a package script cannot ask. The
# message only says what to do. A checksum of the installed plugin files is
# kept next to DreamHub's data so the note appears only when the plugin
# actually changed.
PLUGIN_DIR=/usr/lib/enigma2/python/Plugins/Extensions/DreamHub
SUM_FILE=/data/dreamhub/.plugin.sum
NEW_SUM=$(find "$PLUGIN_DIR" -type f ! -name '*.pyc' ! -name '*.pyo' -exec md5sum {} + 2>/dev/null | sort | md5sum | cut -d' ' -f1)
OLD_SUM=$(cat "$SUM_FILE" 2>/dev/null || true)
if [ "$NEW_SUM" != "$OLD_SUM" ]; then
    echo "dreamhub: the launcher plugin for the TV screen is new or changed."
    echo "dreamhub: it loads at the next enigma2 restart (when it suits you): systemctl restart enigma2"
    echo "dreamhub: DreamHub itself works in the browser already."
    echo "$NEW_SUM" > "$SUM_FILE"
else
    echo "dreamhub: launcher plugin unchanged"
fi

exit 0
