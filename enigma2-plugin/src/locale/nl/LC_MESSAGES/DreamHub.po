"Project-Id-Version: DreamHub 0.3.0\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: nl\n"

msgid "Open DreamHub on your phone"
msgstr "DreamHub op je telefoon openen"

msgid "DreamHub"
msgstr "DreamHub"

msgid "Checking backend…"
msgstr "Backend wordt gecontroleerd…"

msgid "Scan this code with your phone's camera to open DreamHub."
msgstr "Scan deze code met de camera van je telefoon om DreamHub te openen."

msgid "Close"
msgstr "Sluiten"

msgid "Settings"
msgstr "Instellingen"

msgid "Backend running (v%s)\nThis plugin is v%s — versions differ, some things may not match."
msgstr "Backend draait (v%s)\nDeze plugin is v%s — de versies verschillen, niet alles past misschien bij elkaar."

msgid "Backend running (v%s)"
msgstr "Backend draait (v%s)"

msgid "Backend not reachable on this box.\nIs DreamHub installed and running?"
msgstr "Backend niet bereikbaar op deze box.\nIs DreamHub geïnstalleerd en gestart?"

msgid "DreamHub Settings"
msgstr "DreamHub-instellingen"

msgid "Backend port"
msgstr "Backend-poort"

msgid "Cancel"
msgstr "Annuleren"

msgid "Save"
msgstr "Opslaan"

msgid "Change the DreamHub port to %d?\n\nDreamHub restarts for a few seconds. Browsers and bookmarks need the new address (http://<box>:%d)."
msgstr "De DreamHub-poort wijzigen naar %d?\n\nDreamHub herstart enkele seconden. Browsers en bladwijzers hebben het nieuwe adres nodig (http://<box>:%d)."

msgid "The port could not be saved: %s"
msgstr "De poort kon niet worden opgeslagen: %s"

msgid "Or open this address in a browser:\n%s"
msgstr "Of open dit adres in een browser:\n%s"

msgid "The port DreamHub listens on (%d to %d). Changing it restarts DreamHub for a few seconds."
msgstr "De poort waarop DreamHub luistert (%d tot %d). Een wijziging herstart DreamHub een paar seconden."

msgid "The port must be between %d and %d."
msgstr "De poort moet tussen %d en %d liggen."
