#!/bin/sh
# prerm runs before files are removed (both on upgrade and on removal —
# dpkg re-runs postinst afterward on upgrade, so stopping here is safe
# either way). Fill in @EXT_ID@ before building, like postinst.template.
set -e

if [ -d /run/systemd/system ]; then
    systemctl stop @EXT_ID@.service || true
fi

exit 0
