"Content-Transfer-Encoding: 8bit\n"
"Language: de\n"

msgid "Open DreamHub on your phone"
msgstr "DreamHub auf dem Handy öffnen"

msgid "DreamHub"
msgstr "DreamHub"

msgid "Checking backend…"
msgstr "Backend wird geprüft…"

msgid "Scan this code with your phone's camera to open DreamHub."
msgstr "Diesen Code mit der Handykamera scannen, um DreamHub zu öffnen."

msgid "Close"
msgstr "Schließen"

msgid "Settings"
msgstr "Einstellungen"

msgid "Backend running (v%s)\nThis plugin is v%s — versions differ, some things may not match."
msgstr "Backend läuft (v%s)\nDieses Plugin ist v%s — die Versionen weichen ab, manches passt eventuell nicht zusammen."

msgid "Backend running (v%s)"
msgstr "Backend läuft (v%s)"

msgid "Backend not reachable on this box.\nIs DreamHub installed and running?"
msgstr "Backend auf dieser Box nicht erreichbar.\nIst DreamHub installiert und gestartet?"

msgid "DreamHub Settings"
msgstr "DreamHub-Einstellungen"

msgid "Edit Netcast sources"
msgstr "Netcast-Quellen ändern"

msgid "Backend port"
msgstr "Backend-Port"

msgid "Cancel"
msgstr "Abbrechen"

msgid "Save"
msgstr "Speichern"

msgid "Change the DreamHub port to %d?\n\nDreamHub restarts for a few seconds. Browsers and bookmarks need the new address (http://<box>:%d)."
msgstr "Den DreamHub-Port auf %d ändern?\n\nDreamHub startet für ein paar Sekunden neu. Browser und Lesezeichen brauchen die neue Adresse (http://<Box>:%d)."

msgid "The port could not be saved: %s"
msgstr "Der Port konnte nicht gespeichert werden: %s"

msgid "Or open this address in a browser:\n%s"
msgstr "Oder diese Adresse im Browser öffnen:\n%s"

msgid "The port DreamHub listens on (%d to %d). Changing it restarts DreamHub for a few seconds."
msgstr "Der Port, auf dem DreamHub lauscht (%d bis %d). Eine Änderung startet DreamHub für ein paar Sekunden neu."

msgid "The port must be between %d and %d."
msgstr "Der Port muss zwischen %d und %d liegen."
