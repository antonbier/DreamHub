"Content-Transfer-Encoding: 8bit\n"
"Language: fr\n"

msgid "Open DreamHub on your phone"
msgstr "Ouvrir DreamHub sur le téléphone"

msgid "DreamHub"
msgstr "DreamHub"

msgid "Checking backend…"
msgstr "Vérification du backend…"

msgid "Scan this code with your phone's camera to open DreamHub."
msgstr "Scannez ce code avec l’appareil photo du téléphone pour ouvrir DreamHub."

msgid "Close"
msgstr "Fermer"

msgid "Settings"
msgstr "Réglages"

msgid "Backend running (v%s)\nThis plugin is v%s — versions differ, some things may not match."
msgstr "Backend en marche (v%s)\nCe plugin est en v%s — les versions diffèrent, certaines choses peuvent ne pas correspondre."

msgid "Backend running (v%s)"
msgstr "Backend en marche (v%s)"

msgid "Backend not reachable on this box.\nIs DreamHub installed and running?"
msgstr "Backend injoignable sur ce récepteur.\nDreamHub est-il installé et démarré ?"

msgid "DreamHub Settings"
msgstr "Réglages DreamHub"

msgid "Edit Netcast sources"
msgstr "Modifier sources Netcast"

msgid "Backend port"
msgstr "Port du backend"

msgid "Cancel"
msgstr "Annuler"

msgid "Save"
msgstr "Enregistrer"

msgid "Change the DreamHub port to %d?\n\nDreamHub restarts for a few seconds. Browsers and bookmarks need the new address (http://<box>:%d)."
msgstr "Changer le port de DreamHub en %d ?\n\nDreamHub redémarre pendant quelques secondes. Les navigateurs et favoris doivent utiliser la nouvelle adresse (http://<box>:%d)."

msgid "The port could not be saved: %s"
msgstr "Le port n'a pas pu être enregistré : %s"

msgid "Or open this address in a browser:\n%s"
msgstr "Ou ouvrir cette adresse dans un navigateur :\n%s"

msgid "The port DreamHub listens on (%d to %d). Changing it restarts DreamHub for a few seconds."
msgstr "Le port sur lequel DreamHub écoute (%d à %d). Le changer redémarre DreamHub pendant quelques secondes."

msgid "The port must be between %d and %d."
msgstr "Le port doit être compris entre %d et %d."
