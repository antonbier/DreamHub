"Project-Id-Version: DreamHub 0.3.0\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: pl\n"

msgid "Open DreamHub on your phone"
msgstr "Otwórz DreamHub na telefonie"

msgid "DreamHub"
msgstr "DreamHub"

msgid "Checking backend…"
msgstr "Sprawdzanie backendu…"

msgid "Scan this code with your phone's camera to open DreamHub."
msgstr "Zeskanuj ten kod aparatem telefonu, aby otworzyć DreamHub."

msgid "Close"
msgstr "Zamknij"

msgid "Settings"
msgstr "Ustawienia"

msgid "Backend running (v%s)\nThis plugin is v%s — versions differ, some things may not match."
msgstr "Backend działa (v%s)\nTa wtyczka to v%s — wersje się różnią, coś może nie pasować."

msgid "Backend running (v%s)"
msgstr "Backend działa (v%s)"

msgid "Backend not reachable on this box.\nIs DreamHub installed and running?"
msgstr "Backend na tym odbiorniku nie odpowiada.\nCzy DreamHub jest zainstalowany i uruchomiony?"

msgid "DreamHub Settings"
msgstr "Ustawienia DreamHub"

msgid "Edit Netcast sources"
msgstr "Zmieniaj źródła Netcast"

msgid "Backend port"
msgstr "Port backendu"

msgid "Cancel"
msgstr "Anuluj"

msgid "Save"
msgstr "Zapisz"

msgid "Change the DreamHub port to %d?\n\nDreamHub restarts for a few seconds. Browsers and bookmarks need the new address (http://<box>:%d)."
msgstr "Zmienić port DreamHub na %d?\n\nDreamHub uruchomi się ponownie na kilka sekund. Przeglądarki i zakładki wymagają nowego adresu (http://<box>:%d)."

msgid "The port could not be saved: %s"
msgstr "Nie udało się zapisać portu: %s"

msgid "Or open this address in a browser:\n%s"
msgstr "Albo otwórz ten adres w przeglądarce:\n%s"

msgid "The port DreamHub listens on (%d to %d). Changing it restarts DreamHub for a few seconds."
msgstr "Port, na którym nasłuchuje DreamHub (od %d do %d). Zmiana restartuje DreamHub na kilka sekund."

msgid "The port must be between %d and %d."
msgstr "Port musi mieścić się między %d a %d."
