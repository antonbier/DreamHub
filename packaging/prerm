#!/bin/sh
# prerm runs before files are removed (both on upgrade and on removal —
# dpkg re-runs postinst afterward on upgrade, so stopping here is safe
# either way).
set -e

if [ -d /run/systemd/system ]; then
    systemctl stop dreamhub.service || true
    # Disable while the unit file still exists: in postrm it's already
    # gone and `systemctl disable` can't find it, which left a dangling
    # multi-user.target.wants link behind (found on the box, #22).
    if [ "$1" = remove ]; then
        systemctl disable dreamhub.service >/dev/null 2>&1 || true
        # Docker set up from the Apps tab goes with DreamHub; its data on
        # /data/dreamhub-docker stays (removed only on purge).
        systemctl stop dreamhub-dockerd-helper.service dreamhub-docker.service >/dev/null 2>&1 || true
        systemctl disable dreamhub-dockerd-helper.service dreamhub-docker.service >/dev/null 2>&1 || true
    fi
fi

exit 0
