"Project-Id-Version: DreamHub 0.3.0\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: tr\n"

msgid "Open DreamHub on your phone"
msgstr "DreamHub'ı telefonda aç"

msgid "DreamHub"
msgstr "DreamHub"

msgid "Checking backend…"
msgstr "Backend kontrol ediliyor…"

msgid "Scan this code with your phone's camera to open DreamHub."
msgstr "DreamHub'ı açmak için bu kodu telefonunun kamerasıyla tara."

msgid "Close"
msgstr "Kapat"

msgid "Settings"
msgstr "Ayarlar"

msgid "Backend running (v%s)\nThis plugin is v%s — versions differ, some things may not match."
msgstr "Backend çalışıyor (v%s)\nBu eklenti v%s — sürümler farklı, bazı şeyler uyuşmayabilir."

msgid "Backend running (v%s)"
msgstr "Backend çalışıyor (v%s)"

msgid "Backend not reachable on this box.\nIs DreamHub installed and running?"
msgstr "Bu kutuda backend'e ulaşılamıyor.\nDreamHub kurulu ve çalışıyor mu?"

msgid "DreamHub Settings"
msgstr "DreamHub ayarları"

msgid "Backend port"
msgstr "Backend portu"

msgid "Cancel"
msgstr "İptal"

msgid "Save"
msgstr "Kaydet"

msgid "Change the DreamHub port to %d?\n\nDreamHub restarts for a few seconds. Browsers and bookmarks need the new address (http://<box>:%d)."
msgstr "DreamHub bağlantı noktası %d olarak değiştirilsin mi?\n\nDreamHub birkaç saniyeliğine yeniden başlar. Tarayıcılar ve yer imleri yeni adresi kullanmalıdır (http://<box>:%d)."

msgid "The port could not be saved: %s"
msgstr "Bağlantı noktası kaydedilemedi: %s"

msgid "Or open this address in a browser:\n%s"
msgstr "Veya bu adresi tarayıcıda açın:\n%s"

msgid "The port DreamHub listens on (%d to %d). Changing it restarts DreamHub for a few seconds."
msgstr "DreamHub'ın dinlediği bağlantı noktası (%d ile %d arası). Değiştirmek DreamHub'ı birkaç saniyeliğine yeniden başlatır."

msgid "The port must be between %d and %d."
msgstr "Bağlantı noktası %d ile %d arasında olmalıdır."
